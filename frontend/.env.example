# Which backend the frontend talks to. Copy this file to .env (gitignored)
# and uncomment the line for the backend you're running, then restart
# `npm run dev`.

# Django (default if unset) — backend/django, runs on :8000
# VITE_API_BASE=http://127.0.0.1:8000/api

# Flask — backend/flask, runs on :8001
# VITE_API_BASE=http://127.0.0.1:8001/api
